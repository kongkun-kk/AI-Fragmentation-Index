# Copy this file to .env and fill in your keys. NEVER commit .env.

# OpenAI-compatible API (works for OpenAI, DeepSeek, Qwen, Moonshot, local vLLM, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Frontier API models used in ensembling (Step 3) - names as used by your provider
MODEL_API_1=gpt-4o-mini
MODEL_API_2=deepseek-chat

# Open-weight anchor model (local vLLM/Ollama endpoint or an API provider)
OPEN_WEIGHT_ENDPOINT=http://localhost:8000/v1
OPEN_WEIGHT_MODEL=Qwen2.5-32B-Instruct

# Version tags - bump on EVERY change; they are recorded in each code's provenance
PROMPT_VERSION=v1
SCHEMA_VERSION=v1
